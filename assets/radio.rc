#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#pragma code_page(65001)
1 RT_MANIFEST "radio.manifest"
1 ICON "quickstation.ico"
IDI_PLAY ICON "buttons/play.ico"
IDI_STOP ICON "buttons/stop.ico"
IDI_SPEAKER ICON "buttons/speaker.ico"
IDI_MUTED ICON "buttons/muted.ico"
2005 ICON "buttons/play-white.ico"
2006 ICON "buttons/stop-white.ico"
2007 ICON "buttons/speaker-white.ico"
2008 ICON "buttons/muted-white.ico"
IDD_STATION_PAGE DIALOGEX 0,0,200,160
STYLE DS_CONTROL | DS_SETFONT | WS_CHILD | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9,"Segoe UI"
BEGIN
END
IDD_STATION DIALOGEX 0,0,340,222
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Station details"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Station name",IDC_NAME_LABEL,14,12,300,12
 EDITTEXT IDC_NAME,14,27,312,14,ES_AUTOHSCROLL
 LTEXT "Stream URL (HTTP or HTTPS)",IDC_URL_LABEL,14,51,300,12
 EDITTEXT IDC_URL,14,66,312,14,ES_AUTOHSCROLL
 LTEXT "Logo URL (optional)",IDC_LOGO_LABEL,14,90,300,12
 EDITTEXT IDC_LOGO,14,105,312,14,ES_AUTOHSCROLL
 LTEXT "Genre or description (optional)",IDC_GENRE_LABEL,14,129,300,12
 EDITTEXT IDC_GENRE,14,144,312,14,ES_AUTOHSCROLL
 AUTOCHECKBOX "Favorite",IDC_FAVORITE,14,171,130,14
 DEFPUSHBUTTON "Save",IDOK,214,196,54,17
 PUSHBUTTON "Cancel",IDCANCEL,274,196,52,17
END
IDD_BROWSE DIALOGEX 0,0,412,300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Browse stations"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Country",IDC_COUNTRY_LABEL,12,10,184,12
 COMBOBOX IDC_COUNTRY,12,26,184,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Genre",IDC_CATEGORY_LABEL,208,10,192,12
 COMBOBOX IDC_CATEGORY,208,26,192,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Station name (optional)",IDC_QUERY_LABEL,12,52,380,12
 EDITTEXT IDC_QUERY,12,68,326,20,ES_AUTOHSCROLL
 DEFPUSHBUTTON "Browse",IDC_FIND,346,68,54,20
 CONTROL "Stations",IDC_RESULTS,"SysListView32",WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS,12,100,388,154
 LTEXT "",IDC_BROWSE_STATUS,12,260,388,16
 LTEXT "Stations from Radio Browser",IDC_SOURCE,12,280,230,12
 PUSHBUTTON "Add to favorites",IDC_ADD,254,280,90,20
 PUSHBUTTON "Close",IDCANCEL,350,280,50,20
END
1 VERSIONINFO
FILEVERSION 1,6,14,0
PRODUCTVERSION 1,6,14,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "QuickStation - a compact radio player\0"
   VALUE "FileVersion", "1.6.14\0"
   VALUE "InternalName", "QuickStation\0"
   VALUE "OriginalFilename", "QuickStation.exe\0"
   VALUE "ProductName", "QuickStation\0"
   VALUE "ProductVersion", "1.6.14\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation",0x0409,1200
 END
END
